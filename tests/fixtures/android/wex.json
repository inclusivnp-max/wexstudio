{
  "schema": 1,
  "name": "Wex Android Integration",
  "repositories": [
    "https://dl.google.com/dl/android/maven2",
    "https://repo.maven.apache.org/maven2"
  ],
  "android": {
    "compile_sdk": 36,
    "min_sdk": 26,
    "target_sdk": 36,
    "application_id": "dev.wex.android.integration"
  },
  "modules": [
    {
      "name": "app",
      "sources": [
        "app/src/main/kotlin",
        "app/src/main/java"
      ],
      "resources": [
        "app/src/main/res"
      ],
      "projects": [
        "shared"
      ],
      "dependencies": [
        "androidx.core:core:1.13.0",
        "org.jetbrains.kotlin:kotlin-stdlib:2.4.0"
      ],
      "assets": [
        "app/src/main/assets"
      ]
    },
    {
      "name": "shared",
      "sources": [
        "shared/src/main/kotlin"
      ],
      "dependencies": [],
      "namespace": "dev.wex.shared",
      "resources": [
        "shared/src/main/res"
      ]
    }
  ],
  "build": {
    "application_module": "app",
    "namespace": "dev.wex.android",
    "manifest": "app/src/main/AndroidManifest.xml",
    "build_tools": "36.0.0",
    "kotlin_version": "2.4.0",
    "jvm_target": 17,
    "version_code": 1,
    "version_name": "1.0"
  }
}
